# Copy this file to `.env` and adjust as needed. `.env` is git-ignored.

# Which environment YAML to load from config/environments/ (dev | staging | prod)
TEST_ENV=dev

# Application under test
BASE_URL=https://qa-myplc.iapmo.org/
API_BASE_URL=https://jsonplaceholder.typicode.com

# Browser / execution
BROWSER=chromium
HEADLESS=true
SLOW_MO=0
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=30000
RETRIES=1
WORKERS=4
LOCALE=en-US
TIMEZONE=UTC

# Artifacts
RECORD_VIDEO=false
RECORD_TRACE=false
SCREENSHOT_ON_FAILURE=true
IMAGE_THRESHOLD=1

# Logging
LOG_LEVEL=INFO

# ---- Remote / grid execution ----
USE_SELENIUM_GRID=false
SELENIUM_GRID_URL=http://localhost:4444/wd/hub

# ---- Cloud platforms (leave blank unless used) ----
USE_BROWSERSTACK=false
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=

USE_LAMBDATEST=false
LAMBDATEST_USERNAME=
LAMBDATEST_ACCESS_KEY=

# ---- Notifications (leave blank to disable) ----
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# MTPLC multi-role UI workflows (optional until running MTPLC scenarios)
BASE_URL=https://qa-myplc.iapmo.org
MTPLC_USERNAME=R&TEngineer
MTPLC_PASSWORD=password
BROWSER=chromium
HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=15000
R_AND_T_ENGINEER_USERNAME=Anish.Desai
MTPLC_APPLICATION_NUMBER=P-255901
R_AND_T_ENGINEER_PASSWORD=password

VANESSA_USERNAME=Vanessa.Iraheta
VANESSA_PASSWORD=password

R_AND_T_ADMIN_USERNAME=R&TPlumbingCertificationAdmin
